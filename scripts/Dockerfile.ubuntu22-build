# Development-only GNU/Linux baseline for Ubuntu Server 22.04 (glibc 2.35).
FROM rust@sha256:a8a5f0a1e5fe7dfe1d352591e4a1c7dd2c08fd70475cae872cf3458ba0df0546 AS rust
FROM ubuntu:22.04@sha256:9abcaffc92a5279fff3a6a41635c0800ea33e528425fb389658806476e7defde

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential ca-certificates python3 openssh-client openssh-server \
    && useradd --create-home --uid 1000 --shell /bin/sh serverui-build \
    && useradd --create-home --uid 1001 --shell /bin/sh serverui-test \
    && passwd -d serverui-test \
    && mkdir -p /run/sshd

COPY --from=rust /usr/local/rustup/ /usr/local/rustup/
COPY --from=rust /usr/local/cargo/ /usr/local/cargo/
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN rustc --version \
    && rustup component add --toolchain 1.98.1 clippy rustfmt \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo

USER serverui-build
ENV CARGO_HOME=/tmp/serverui-cargo CARGO_TARGET_DIR=/tmp/serverui-target
WORKDIR /workspace
CMD ["cargo", "build", "--release", "--locked"]
